src/main.s: src/main.cpp.s
.PHONY : src/main.s

# target to generate assembly for a file
src/main.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/corkytux.dir/build.make CMakeFiles/corkytux.dir/src/main.cpp.s
.PHONY : src/main.cpp.s

