<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?import javafx.scene.*?>
<?import javafx.collections.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.corkytux.launcher.forms.MainForm" prefHeight="700" prefWidth="1200" style="-fx-background-color:#000000;">
  <BorderPane fx:id="mainBorderPane">

  <!-- ===== TOP BAR ===== -->
  <top>
    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#000000; -fx-padding:10 16;" BorderPane.alignment="CENTER_LEFT">
      <children>
        <!-- Logo -->
        <ImageView fitHeight="32" fitWidth="32" preserveRatio="true">
          <image>
            <Image url="@../img/corkytux.png"/>
          </image>
        </ImageView>

        <!-- Add Game button (old UI style: icon + text) -->
        <Button fx:id="btnAddGameTop" text="Add game" styleClass="btn-primary" alignment="CENTER_LEFT" contentDisplay="LEFT" style="-fx-text-fill:#ffffff; -fx-padding:8 20 8 10; -fx-graphic-text-gap:8;">
          <graphic>
            <StackPane minWidth="20" minHeight="20" maxWidth="20" maxHeight="20" style="-fx-border-color:#ffffff; -fx-border-width:1.5; -fx-border-radius:50;">
              <children>
                <Rectangle width="10" height="2" fill="#ffffff"/>
                <Rectangle width="2" height="10" fill="#ffffff"/>
              </children>
            </StackPane>
          </graphic>
        </Button>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Settings button -->
        <Button fx:id="aboutButton" text="Settings" styleClass="btn-outline"/>
      </children>
    </HBox>
  </top>

  <!-- ===== LEFT SIDEBAR - Game Library ===== -->
  <left>
    <VBox styleClass="sidebar-left" prefWidth="320" spacing="8" BorderPane.alignment="CENTER_LEFT">
      <children>
        <!-- Library header -->
        <VBox styleClass="sidebar-section" spacing="12">
          <children>
            <HBox alignment="CENTER_LEFT" spacing="8">
              <padding>
                <Insets right="12"/>
              </padding>
              <children>
                <Label text="Your Library" styleClass="sidebar-title" HBox.hgrow="ALWAYS"/>
              </children>
            </HBox>

            <!-- Category tabs (2 per row) -->
            <GridPane fx:id="categoryTabs" hgap="6" vgap="6">
              <children>
                <Button fx:id="filterAll" text="All" styleClass="sidebar-tab" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button fx:id="filterFavorites" text="Favorites" styleClass="sidebar-tab" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button fx:id="filterAZ" text="A-Z" styleClass="sidebar-tab" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button fx:id="filterMostPlayed" text="Most Played" styleClass="sidebar-tab" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button fx:id="filterRecent" text="Recently Added" styleClass="sidebar-tab" maxWidth="Infinity" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2"/>
              </children>
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
              </columnConstraints>
            </GridPane>

            <!-- Search in library -->
            <HBox styleClass="search-filter" alignment="CENTER_LEFT" spacing="6">
              <children>
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true" smooth="true">
                  <image>
                    <Image url="@../img/search.png"/>
                  </image>
                </ImageView>
                <TextField fx:id="librarySearch" promptText="Search in your library" prefWidth="250"/>
              </children>
            </HBox>
          </children>
        </VBox>

        <!-- Game list (scrollable) -->
        <ScrollPane fitToWidth="true" pannable="true" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent; -fx-background:transparent;" hbarPolicy="NEVER">
          <content>
            <VBox fx:id="gameList" styleClass="game-list" spacing="2">
              <children>
                <!-- Games will be added dynamically -->
              </children>
            </VBox>
          </content>
        </ScrollPane>
      </children>
    </VBox>
  </left>

  <!-- ===== MAIN CONTENT - Game Cards Grid ===== -->
  <center>
    <ScrollPane fx:id="container" fitToWidth="true" style="-fx-background-color:#121212; -fx-background-radius:8;" BorderPane.alignment="CENTER">
      <content>
        <VBox fx:id="containerContent" spacing="24" style="-fx-padding:24;">
          <children>
            <!-- Empty state -->
            <VBox fx:id="noGamesHeader" alignment="CENTER" spacing="12" visible="true" managed="true" style="-fx-background-color:#181818; -fx-background-radius:12; -fx-padding:40;">
              <children>
                <Label text="No games yet" style="-fx-text-fill:#ffffff; -fx-font-size:24; -fx-font-weight:bold;"/>
                <Label text="Add a game to get started" style="-fx-text-fill:#a7a7a7; -fx-font-size:14;"/>
                <Button fx:id="addGameButtonCenter" text="Add Game" styleClass="btn-primary" prefWidth="140"/>
              </children>
            </VBox>

            <!-- Recently Played section -->
            <VBox fx:id="recentlyPlayedSection" spacing="16" visible="false" managed="false">
              <children>
                <HBox alignment="CENTER_LEFT">
                  <children>
                    <Label text="Recently Played" styleClass="content-title" HBox.hgrow="ALWAYS"/>
                    <Button text="Show all" styleClass="btn-outline"/>
                  </children>
                </HBox>
                <FlowPane fx:id="recentlyPlayedFlow" hgap="16" vgap="16"/>
              </children>
            </VBox>

            <!-- All Games section -->
            <VBox fx:id="allGamesSection" spacing="16" visible="false" managed="false">
              <children>
                <HBox alignment="CENTER_LEFT">
                  <children>
                    <Label text="All Games" styleClass="content-title" HBox.hgrow="ALWAYS"/>
                  </children>
                </HBox>
                <FlowPane fx:id="flowContent" hgap="16" vgap="16"/>
              </children>
            </VBox>
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </center>
  </BorderPane>

  <!-- ===== GAME DETAILS OVERLAY (floats right, no layout resize) ===== -->
    <VBox fx:id="gamePanel" styleClass="sidebar-right" spacing="0" visible="false" managed="false" StackPane.alignment="CENTER_RIGHT" maxHeight="Infinity" prefWidth="380" maxWidth="380">
      <StackPane.margin>
        <Insets top="60" right="12" bottom="12"/>
      </StackPane.margin>
      <children>
        <ScrollPane fitToWidth="true" pannable="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" style="-fx-background-color:transparent; -fx-background:transparent;">
          <content>
            <VBox spacing="16">
              <children>
        <!-- Game title + favorite star -->
        <HBox alignment="CENTER_LEFT" spacing="8">
          <padding>
            <Insets right="8"/>
          </padding>
          <children>
            <Label fx:id="gameTitle" text="Game Title" styleClass="game-detail-title" HBox.hgrow="ALWAYS"/>
            <Button fx:id="gameMenuButton" styleClass="btn-icon" prefWidth="36" prefHeight="36" maxWidth="36" maxHeight="36">
              <graphic><Label fx:id="favoriteStarLabel" text="&#9734;" style="-fx-font-size:24; -fx-text-fill:#a7a7a7;"/></graphic>
              <HBox.margin>
                <Insets left="8"/>
              </HBox.margin>
            </Button>
          </children>
        </HBox>

        <!-- Game cover (fixed frame, no overflow onto Play) -->
        <StackPane prefWidth="348" prefHeight="200" minWidth="348" minHeight="200" maxWidth="348" maxHeight="200" style="-fx-background-color:#282828; -fx-background-radius:8;">
          <children>
            <ImageView fx:id="gameHeader" fitWidth="340" fitHeight="192" preserveRatio="true"/>
          </children>
        </StackPane>

        <!-- Play button (single) -->
        <Button fx:id="playButton" text="Play" maxWidth="Infinity" alignment="CENTER" contentDisplay="LEFT" styleClass="split-btn-main" style="-fx-background-radius:20; -fx-text-fill:#ffffff; -fx-font-weight:bold; -fx-font-size:13; -fx-padding:10 24; -fx-cursor:hand;"/>

        <!-- Time played -->
        <HBox alignment="CENTER_LEFT" spacing="4">
          <children>
            <Label text="Time played:" style="-fx-text-fill:#a7a7a7; -fx-font-size:12;"/>
            <Label fx:id="timeLabel" text="0 h" style="-fx-text-fill:#ffffff; -fx-font-size:12;"/>
          </children>
        </HBox>

        <!-- Install info -->
        <VBox spacing="8">
          <children>
            <Label text="Install Info" style="-fx-text-fill:#ffffff; -fx-font-size:14; -fx-font-weight:bold;"/>
            <VBox fx:id="installInfoBox" styleClass="game-detail-info" spacing="6">
              <children>
                <VBox spacing="2">
                  <children>
                    <Label text="SIZE" styleClass="info-label"/>
                    <Label fx:id="gameSize" text="--" styleClass="info-value"/>
                  </children>
                </VBox>
                <Separator style="-fx-padding:4 0;"/>
                <VBox spacing="2">
                  <children>
                    <Label text="INSTALL PATH" styleClass="info-label"/>
                    <Label fx:id="gameInstallPath" text="--" styleClass="info-value" wrapText="true"/>
                  </children>
                </VBox>
                <Separator style="-fx-padding:4 0;"/>
                <VBox spacing="2">
                  <children>
                    <Label text="PREFIX PATH" styleClass="info-label"/>
                    <Label fx:id="gamePrefixPath" text="--" styleClass="info-value" wrapText="true"/>
                  </children>
                </VBox>
              </children>
            </VBox>
          </children>
        </VBox>

        <!-- Action buttons grid -->
        <VBox spacing="8">
          <children>
            <Label text="Actions" style="-fx-text-fill:#ffffff; -fx-font-size:14; -fx-font-weight:bold;"/>
            <VBox styleClass="action-grid" spacing="4">
              <children>
                <HBox spacing="4">
                  <children>
                    <Button fx:id="gameSettingsButton" text="Settings" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="gameDebugButton" text="Debug" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="gameDeleteButton" text="Remove" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                  </children>
                </HBox>
                <HBox spacing="4">
                  <children>
                    <Button fx:id="utilitiesButton" text="Wine" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="runInPrefixButton" text="Run exe" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="gameFolderButton" text="Folders" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                  </children>
                </HBox>
                <HBox spacing="4">
                  <children>
                    <Button fx:id="steamDBButton" text="SteamDB" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="protonDBButton" text="ProtonDB" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                    <Button fx:id="steamButton" text="Steam" styleClass="action-btn" prefWidth="100" maxWidth="Infinity" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" contentDisplay="LEFT"/>
                  </children>
                </HBox>
              </children>
            </VBox>
          </children>
        </VBox>
              </children>
            </VBox>
          </content>
        </ScrollPane>
      </children>
    </VBox>

  <!-- Modal overlay -->
  <VBox fx:id="modalOverlay" visible="false" managed="false" style="-fx-background-color:rgba(0,0,0,0.7);" alignment="CENTER">
    <VBox fx:id="modalContent" style="-fx-background-color:#121212; -fx-background-radius:12; -fx-border-color:#282828; -fx-border-radius:12; -fx-padding:0;" maxWidth="900" maxHeight="600" prefWidth="900" prefHeight="600">
      <children>
        <!-- Modal header -->
        <HBox fx:id="modalHeader" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#121212; -fx-padding:16 24; -fx-border-color:transparent transparent #282828 transparent; -fx-border-width:0 0 1 0;">
          <children>
            <Label fx:id="modalTitle" text="Settings" style="-fx-text-fill:#ffffff; -fx-font-size:18; -fx-font-weight:bold;" HBox.hgrow="ALWAYS"/>
            <Button fx:id="modalCloseButton" styleClass="btn-icon" prefWidth="32" prefHeight="32" maxWidth="32" maxHeight="32">
              <graphic><Label text="&#10005;" styleClass="accent-text" style="-fx-font-size:14;"/></graphic>
            </Button>
          </children>
        </HBox>
        <!-- Modal body - content loaded here -->
        <StackPane fx:id="modalBody" style="-fx-padding:0;" VBox.vgrow="ALWAYS"/>
      </children>
    </VBox>
  </VBox>
</StackPane>
