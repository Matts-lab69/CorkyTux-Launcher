#!/usr/bin/env bash
set -euo pipefail

INSTALL_DIR="${HOME}/.local/share/corkytux"
JAR="${INSTALL_DIR}/corkytux.jar"

JAVA_HOME="${JAVA_HOME:-}"
if [[ -z "$JAVA_HOME" ]] || [[ ! -f "$JAVA_HOME/bin/java" ]]; then
  # Direct path checks (no grep -P needed)
  for p in /opt/jvm/temurin-25 /opt/jvm/temurin-24 /opt/jvm/temurin-23 /opt/jvm/temurin-22 /opt/jvm/temurin-21; do
    [[ -x "$p/bin/java" ]] && { JAVA_HOME="$p"; break; }
  done
fi
if [[ -z "$JAVA_HOME" ]] || [[ ! -f "$JAVA_HOME/bin/java" ]]; then
  for p in /usr/lib/jvm/java-25-temurin /usr/lib/jvm/java-21-temurin /usr/lib/jvm/openjdk-25 /usr/lib/jvm/openjdk-21; do
    [[ -x "$p/bin/java" ]] && { JAVA_HOME="$p"; break; }
  done
fi
if [[ -z "$JAVA_HOME" ]] || [[ ! -f "$JAVA_HOME/bin/java" ]]; then
  if command -v java &>/dev/null; then
    JAVA_HOME="$(dirname "$(dirname "$(readlink -f "$(command -v java)")")")"
  fi
fi

if [[ -z "$JAVA_HOME" ]] || [[ ! -f "${JAVA_HOME}/bin/java" ]]; then
  notify-send "CorkyTux" "Java 21+ not found. Install Temurin 21+." 2>/dev/null
  echo "Error: Java 21+ not found. Install Adoptium Temurin 21+: https://adoptium.net" >&2
  exit 1
fi

# Version check
JAVA_VER=$("${JAVA_HOME}/bin/java" -version 2>&1 | head -1 | sed -n 's/.*"\([0-9][0-9]*\).*/\1/p')
if [[ "${JAVA_VER:-0}" -lt 21 ]]; then
  notify-send "CorkyTux" "Java 21+ required, found Java ${JAVA_VER}" 2>/dev/null
  echo "Error: Java 21+ required, found Java ${JAVA_VER}" >&2
  exit 1
fi

exec "${JAVA_HOME}/bin/java" \
  ${CORKYTUX_JAVA_OPTS:--Xmx512m} \
  -jar "${JAR}" "$@"
